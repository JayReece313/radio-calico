# Copy this file to .env and fill in values before running in production.
# .env is gitignored — never commit real credentials.

# REQUIRED: set to a strong random password. docker compose up will fail fast if unset.
# Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Optional: host port for nginx (default 80)
# PORT=80

# Optional: allow a specific external origin for CORS (default: same-origin only)
# CORS_ORIGIN=https://yourdomain.com
