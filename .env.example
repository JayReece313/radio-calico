# Copy this file to .env and fill in values before running in production.
# .env is gitignored — never commit real credentials.

# REQUIRED: change to a strong random password for any internet-facing deployment
POSTGRES_PASSWORD=changeme

# Optional: host port for nginx (default 80)
# PORT=80

# Optional: allow a specific external origin for CORS (default: same-origin only)
# CORS_ORIGIN=https://yourdomain.com
